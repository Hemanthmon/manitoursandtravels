# Postgres connection string (Neon) — use the POOLED connection string, not the direct one.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth.js v5 — signs/encrypts session JWTs for /admin.
# Generate with: openssl rand -hex 32
AUTH_SECRET=YOUR_AUTH_SECRET_HERE

# Cloudinary: package image uploads (web admin + mobile app).
# Find these at https://console.cloudinary.com > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=e1u3lx04
CLOUDINARY_API_KEY=537399322812429
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET_HERE

# Optional: only needed if "Enhanced push security" is on in your Expo account.
# EXPO_ACCESS_TOKEN=

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare Turnstile (spam protection on public forms).
# Defaults below are Cloudflare's official "always passes" TEST keys — safe for local dev,
# replace with real keys (https://dash.cloudflare.com/?to=/:account/turnstile) before production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
