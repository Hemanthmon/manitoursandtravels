# Base URL of the Next.js site that serves /api/mobile/* — no trailing slash.
# On a physical phone with Expo Go, use your PC's LAN IP (not localhost), e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Release APKs block plain http, so use your deployed https domain there
# (set in eas.json build profiles).
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
